# Preview + dry-run is the first-run path. Copy this file outside source
# control, replace every REPLACE_* value, and never commit the populated copy.
MIDNIGHT_NETWORK_ID=preview
SOLVER_ENABLED=true
SOLVER_DRY_RUN=true

SOLVER_SEED=REPLACE_WITH_DEDICATED_SOLVER_SEED
ZSWAP_API=https://offer-files-backend.invalid
SOLVER_LADDER_CONFIG=/etc/cow-solver/ladders.json
MIDNIGHT_INDEXER_HTTP=https://indexer.invalid/api/v1/graphql
MIDNIGHT_INDEXER_WS=wss://indexer.invalid/api/v1/graphql/ws
MIDNIGHT_NODE_HTTP=https://midnight-node.invalid
MIDNIGHT_PROOF_SERVER_URL=https://proof-server.invalid

# Optional admission policy. Each unset group remains open under the current
# solver behavior. Replace the examples with real lowercase 64-hex token IDs.
# SOLVER_SUPPORTED_PAIRS=["REPLACE_64HEX_GIVE->REPLACE_64HEX_WANT"]
# SOLVER_MIN_JOB_OUTPUT={"REPLACE_64HEX_OUTPUT_TOKEN":"REPLACE_POSITIVE_INTEGER_STRING"}
# The three DUST values are all-set or all-unset.
# SOLVER_DUST_MAX_PER_JOB=REPLACE_POSITIVE_INTEGER
# SOLVER_DUST_MAX_PER_WINDOW=REPLACE_POSITIVE_INTEGER
# SOLVER_DUST_WINDOW_MS=REPLACE_POSITIVE_INTEGER
# SOLVER_ADMISSION_WARNING_INTERVAL_MS=REPLACE_POSITIVE_INTEGER

# Live mode only: set SOLVER_DRY_RUN=false and provide every value below.
# SOLVER_RELAY_WS_URL=wss://relay.invalid/solver
# SOLVER_RELAY_HTTP_URL=https://relay.invalid/api/v1
# SOLVER_RELAY_AUTH_TOKEN=REPLACE_WITH_SECRET_FROM_INFRASTRUCTURE
# SOLVER_JOURNAL_PATH=/var/lib/cow-solver/operations.sqlite

# Mainnet live mode only (never needed for mainnet dry-run):
# SOLVER_MAINNET_LIVE_TRADING_ACK=true
