# =============================================================================
# ZSwap-DA kernel — mainnet env contract (Midnight 2.x / ledger 9)
#
# One file for the public-network services:
#   [kernel]   packages/node/main.public.ts        (:9999; preflight:
#              bun run packages/node/public-network-profile.ts)
#   [batcher]  packages/batcher/batcher.public.ts  (:3334; preflight: --check)
#   [poster]   deploy/scripts/offer-poster.ts
#   [registry] packages/database/import-token-registry.ts (one-shot)
#   [solver]   packages/solver/solver.mainnet.ts / bun run start:solver
# Each variable names the services that read it. Uncommented lines are the
# contract; commented lines are optional knobs shown with their default.
# SECRETS are left EMPTY here: fill them only in the real (uncommitted) env,
# never on a command line.
#
# Check a filled-in copy with:  cp .env.mainnet.example .env && bun check-env.ts
#
# Mainnet constants: block 1 = 2026-03-18T14:19:42Z (NTP anchor
# 1773843582000), ~6 s blocks; Celestia mainnet on the MIP-0006 shared
# namespace mn-swap-v1 (6d6e2d737761702d7631, not overridden); zswap root
# window = ledger-9 global_ttl = 1209600 s (14 days).
#
# REAL FUNDS: every wallet below holds real NIGHT/DUST, tokens or TIA. Real
# funds stay NO-GO on this line until the solver is re-audited and the owner
# decides again; the mainnet profile is proven read-only. See README.md.
#
# DOES NOT START YET: mainnet's ledger-9 reference parameters are not pinned
# (packages/validator/reference-parameters.ts), so the node and the batcher
# refuse MIDNIGHT_NETWORK_ID=mainnet (exit 78), and check-env.ts fails on it,
# until they are.
# The rest of this file is the contract they check.
# =============================================================================

# ── Midnight network [kernel, batcher, poster, registry] ─────────────────────
MIDNIGHT_NETWORK_ID=mainnet
# REQUIRED (SECRET): the Blockfrost project token for mainnet (one free project
# per network at https://blockfrost.io; a token of another network is refused
# with HTTP 403 "Network token mismatch" and the kernel stops naming this
# variable). The default endpoints are Blockfrost-hosted:
#   https://midnight-mainnet.blockfrost.io/api/v0      (indexer, WS …/api/v0/ws)
#   https://rpc.midnight-mainnet.blockfrost.io         (node)
# each with ?project_id=<token>. Every logged or served endpoint shows
# project_id=<redacted>.
MIDNIGHT_BLOCKFROST_PROJECT_ID=
# Optional full overrides, each replacing its URL verbatim (all three set =
# no token needed). The Midnight-hosted mainnet endpoints
# (indexer.mainnet.midnight.network, rpc.mainnet.midnight.network) were
# retired on 2026-10-09 and are refused at startup.
# MIDNIGHT_INDEXER_HTTP=
# MIDNIGHT_INDEXER_WS=
# MIDNIGHT_NODE_HTTP=
# A proof server you run (proof-server 9.0.1). The batcher and the poster
# prove; the kernel only advertises it to browser wallets in
# GET /v1/midnight/config.
MIDNIGHT_PROOF_SERVER_URL=http://proof-server:6300
# Older alias of MIDNIGHT_PROOF_SERVER_URL (read when that one is unset).
# MIDNIGHT_PROOF_SERVER=
# [kernel] First Midnight block to index. The nullifier set must be complete,
# so keep 1 (the NTP anchor is block 1's time).
# MIDNIGHT_START_BLOCK=1
# [batcher, poster] wallet-SDK sync budget, ms.
# MIDNIGHT_WALLET_SYNC_TIMEOUT_MS=
# MIDNIGHT_WAIT_DUST_POLL_INTERVAL_MS=

# ── Celestia mainnet [kernel, batcher] ───────────────────────────────────────
# The Celestia mainnet RPC of a light node / provider whose signer holds TIA
# (the batcher pays one blob fee per sponsored offer, in real TIA). REQUIRED.
# A local light node:
#   celestia light init --p2p.network celestia
#   celestia light start --core.ip <consensus-rpc> --core.port 9090 --core.tls --p2p.network celestia
#   celestia light auth admin --p2p.network celestia   # -> CELESTIA_AUTH_TOKEN
CELESTIA_RPC_URL=
# REQUIRED (SECRET): the RPC bearer token (sent as Authorization: Bearer; the
# kernel's sync reads it too). If CELESTIA_RPC_URL embeds its own credential
# (the QuickNode pattern), leave this empty and set CELESTIA_AUTH_IN_URL=true
# instead — never log that URL.
CELESTIA_AUTH_TOKEN=
# CELESTIA_AUTH_IN_URL=false
# [kernel] REQUIRED: the Celestia mainnet height to start reading offers from.
# Pin it deliberately (at or a little before the first mainnet offer you care
# about);
# there is no fallback to 1. The runtime snapshots it on the first boot and
# refuses a changed value afterwards unless USE_DB_STARTHEIGHT is set.
CELESTIA_START_HEIGHT=
# CELESTIA_NETWORK=mainnet
# Leave UNSET: mainnet posts and reads the MIP-0006 shared namespace
# 6d6e2d737761702d7631 (mn-swap-v1) on Celestia mainnet.
# CELESTIA_NAMESPACE=
# [kernel] sync knobs. 30 s (~2.5 blocks) keeps the sync under public
# consensus gRPC rate limits; raise it if you still see 429s.
# CELESTIA_POLLING_INTERVAL_MS=30000
# CELESTIA_STEP_SIZE=200
# CELESTIA_FETCH_CONCURRENCY=12
# [batcher] blob TxConfig (celestia-node v0.30+). Each field set removes one
# consensus-gRPC call per submit. Recommended (minimum on-chain gas price is
# 0.002 utia/gas; leave CELESTIA_GAS unset so blob size is auto-estimated):
# CELESTIA_GAS_PRICE=0.002
# CELESTIA_MAX_GAS_PRICE=0.01
# CELESTIA_TX_PRIORITY=1
# CELESTIA_GAS=

# ── Database: external Postgres [kernel, registry] ───────────────────────────
# PGLITE=false is REQUIRED for an external Postgres: the runtime defaults
# PGLITE to true (single-connection PGlite mode, and DB_PW is then never
# sent). Start on an EMPTY database: data written by a ledger-8 kernel does not
# deserialize under ledger 9.
PGLITE=false
DB_HOST=
DB_PORT=5432
DB_USER=postgres
# SECRET
DB_PW=
DB_NAME=postgres
# [kernel] Only after a deliberate change of CELESTIA_START_HEIGHT /
# NTP_START_TIME on an existing database (the DB snapshot then wins).
# USE_DB_STARTHEIGHT=

# ── Kernel: sync node + API [kernel] ─────────────────────────────────────────
# NTP anchor (mainnet block 1) and the 10-minute NTP block time are the
# defaults; override only when resyncing from a different anchor.
# NTP_START_TIME=1773843582000
# BLOCK_TIME_MS=600000
# NTP_STEP_SIZE=1000
# MIDNIGHT_DELAY_MS=30000
# Root window (seconds): default 1209600 = the ledger-9 global_ttl. A shielded
# offer carries no TTL and expires when its proof root leaves this window.
# ROOT_WINDOW_SECONDS=1209600
# OFFER_TTL_SECONDS is not an offer lifetime or cap: offers expire at their own
# ledger limits (root window; intent TTL for intents). It is only the fallback
# for an offer with neither; leave it unset (setting it logs a warning).
# OFFER_TTL_SECONDS=
# EFFECTSTREAM_API_PORT=9999
# Behind a reverse proxy: trust it (true | false | comma-separated IPs/CIDRs).
# EFFECTSTREAM_TRUST_PROXY=true
# Where the kernel forwards POST /v1/offers blobs (the batcher's HTTP API).
BATCHER_SUBMIT_URL=http://batcher:3334
# BATCHER_SUBMIT_TIMEOUT_MS=
# BATCHER_PORT=3334
# POST /v1/known-tokens (register an extra token). Off by default; the route
# has NO authentication — enable only if you accept that anyone can register a
# token name, or insert the rows in Postgres instead.
# ENABLE_TOKEN_REGISTRY=false
# API_RATE_LIMIT_MAX=600
# API_RATE_LIMIT_ALLOWLIST=
# API_SSE_MAX_CONNECTIONS=100
# API_UPDATES_MAX_CONNECTIONS=100
# OFFER_FILES_READ_TIMEOUT_MS=15000
# OFFER_MAX_BYTES=1048576
# ALLOW_CONTRACT_MAKER_OFFERS=false
# PRICE_FEED_MAP=

# ── Fee sponsorship [kernel, batcher] — the SAME names in both ───────────────
# SPONSOR_DISCOUNT_BPS=250
# BATCHER_SPONSOR_POLICY=warn
# BATCHER_SPONSOR_UNPRICED=allow

# ── Batcher [batcher] ────────────────────────────────────────────────────────
# REQUIRED (SECRET): a DEDICATED seed, 64 hex (or 128 from a mnemonic), whose
# NIGHT is registered for DUST. A missing value or any repository dev seed is
# refused (exit 78) — there is no fallback. Never reuse it for another service.
BATCHER_WALLET_SEED=
# REQUIRED: absolute path on a persistent volume — parked inputs and the
# DUST-state cache (${BATCHER_STORAGE_DIR}/dust-state).
BATCHER_STORAGE_DIR=/var/lib/batcher
# The kernel API the batcher asks for prices (GET /v1/prices).
BATCHER_NODE_API_URL=http://kernel:9999
# BATCHER_POLLING_INTERVAL_MS=250
# Concurrent balancing txs: one per registered NIGHT UTXO at most (default 1
# off undeployed). Split the batcher's NIGHT into several UTXOs to raise it.
# BATCHER_MAX_SLOTS_PER_WALLET=1
# BATCHER_MAX_RETRIES=
# BATCHER_RETRY_DELAY_MS=
# BATCHER_DUST_WAIT_TIMEOUT_MS=
# BATCHER_MIN_SPENDABLE_DUST_PER_COIN=
# BATCHER_MAX_INPUT_CHARS=
# BATCHER_PRICE_TTL_MS=600000
# BATCHER_PRICE_MAX_AGE_MS=172800000
# BATCHER_ALLOW_CONTRACT_TX=false

# ── Offer poster [poster] ────────────────────────────────────────────────────
ZSWAP_API=http://kernel:9999
# Older alias of ZSWAP_API (read when that one is unset).
# NODE_URL=
# REQUIRED (SECRET), exactly one: the poster's OWN wallet (a repository dev
# seed is refused). Fund it with the GIVE_TOKEN coins by hand — the poster
# pays no fees.
POSTER_SEED=
# POSTER_MNEMONIC=
# REQUIRED: 64-hex shielded token IDs of mainnet tokens.
GIVE_TOKEN=
WANT_TOKEN=
# GIVE_AMOUNT=1
# GIVE_MIN=
# GIVE_MAX=
# WANT_AMOUNT=
# POST_INTERVAL_MS=60000
# Intent TTL only: inert for the poster's shielded-only offers.
# OFFER_TTL_MINUTES=60
# RECONCILE_INTERVAL_MS=60000
# POSTER_MAX_REOFFERS_PER_TICK=1
# SHUTDOWN_GRACE_MS=15000
# HEALTH_STALE_TICKS=3
# POSTER_HEALTH_PORT=9977
# DRY_RUN=false
# POSTER_JOURNAL_FILE=/var/lib/offer-poster/journal.json
# POSTER_JOURNAL_RESET=false
# POSTER_SYNC_TIMEOUT_MS=180000
# POSTER_POST_RETRIES=24
# POSTER_POST_RETRY_MS=5000
# POSTER_LIVE_TRIES=40
# POSTER_LIVE_INTERVAL_MS=5000
# KERNEL_WAIT_TIMEOUT_S=600

# ── Token-registry one-shot [registry] ───────────────────────────────────────
# Mainnet has no canonical token-registry source yet: the one-shot imports
# nothing and exits 0, and NIGHT is the only token listed.
TOKEN_REGISTRY_NETWORK=mainnet

# ── Reference prices (packages/price-feed) — OPTIONAL ────────────────────────
# The schema seeds USD reference prices, so quotes work with no key. Set the
# key to have them refreshed daily by the separate `price-feed` process.
# MAINNET NOTE: the seeded values are a development baseline; where the
# sponsorship gate decides whether real fees are paid, run the feed — a stale
# reference price is what makes "2.5% below market" mean the wrong thing.
# The mainnet USDM token type is
# 8c2c22bc0c37fa999d0611cb5c570f587938ac5ffc8b0925143dad4c0764e94b; map it by
# colour: PRICE_FEED_MAP=8c2c22bc0c37fa999d0611cb5c570f587938ac5ffc8b0925143dad4c0764e94b=usdm-2:6
# SECRET: never in the repo, never on a command line. Sent as the
# `x-cg-demo-api-key` header, never as a query parameter.
# COINGECKO_API_KEY=
# PRICE_FEED_INTERVAL_MS=86400000
# PRICE_FEED_REQUEST_SPACING_MS=1000
# PRICE_FEED_BATCH_SIZE=50
# PRICE_FEED_ASSETS=bitcoin,ethereum,usd-coin,midnight-3,usdm-2

# ── COW solver component (bun run start:solver) ───────────────────────────────
# `start:solver` runs the solver as its OWN process; neither the kernel nor the
# batcher entry launches it. That entrypoint requires all of
# MIDNIGHT_NETWORK_ID, ZSWAP_API, SOLVER_SEED, SOLVER_RELAY_WS_URL,
# SOLVER_RELAY_HTTP_URL, SOLVER_RELAY_AUTH_TOKEN and SOLVER_JOURNAL_PATH — in
# dry-run as well as live mode — and exits non-zero listing every missing or
# malformed one before it opens a wallet, socket or journal.
# The solver mirrors the kernel API named by ZSWAP_API (set in the poster
# section above); start:solver refuses to assume http://127.0.0.1:9999.

# Solver process safety boundary. The mainnet entrypoint defaults to dry-run;
# live settlement requires both of the following explicit values. Keep the
# acknowledgement false until the wallet, ladder config, URLs, and a controlled
# staging rehearsal have been reviewed. Dry-run requires SOLVER_SEED, syncs the
# real wallet, and loads read-only inventory, but starts no relay jobs and calls
# no mutating wallet methods.
SOLVER_DRY_RUN=true
SOLVER_MAINNET_LIVE_TRADING_ACK=false

# BREAKING for RF3 dry-run too: the mainnet entrypoint refuses the repository's
# public dev seed in every mode. Supply the funded mainnet wallet seed through
# your secret manager; never commit it here. `start:solver` accepts that dev
# seed only on MIDNIGHT_NETWORK_ID=undeployed.
# FUND BOTH SIDES: the solver publishes only the ladder prefix its own holdings
# can execute, so a wallet without the INPUT token of a pair publishes nothing
# for that pair, and one without the OUTPUT token cannot pay interior residuals.
SOLVER_SEED=

# BREAKING / REQUIRED before relay job execution: mount a persistent volume
# per solver instance and point this at an absolute path inside that mount.
# Docker example: --mount type=volume,src=cow-solver-journal,dst=/var/lib/cow-solver
# Never share one SQLite file between solver instances. Production rejects
# :memory: even when SOLVER_JOURNAL_ALLOW_MEMORY is set (that flag is harness-only).
SOLVER_JOURNAL_PATH=/var/lib/cow-solver/operations.sqlite

# Outbound Midnight Intents solver socket plus the independent public HTTP base
# for durable GET /jobs/:jobId recovery. Do not derive/rewrite one from the
# other: deployed prefixes may differ. The backend exact-files/consumption
# reads have no bearer; this credential is scoped only to the relay upgrade.
SOLVER_RELAY_WS_URL=wss://replace-with-relay.example/solver
SOLVER_RELAY_HTTP_URL=https://replace-with-relay.example/api/v1
SOLVER_RELAY_AUTH_TOKEN=replace-with-matching-at-least-32-character-relay-secret
SOLVER_RELAY_MAX_PARALLEL_SWAPS=8
SOLVER_RELAY_PUSH_INTERVAL_MS=1000
SOLVER_RELAY_RECONNECT_DELAY_MS=2000
SOLVER_STATUS_POLL_MS=5000
SOLVER_SETTLE_TTL_MINUTES=30

# Economic admission. Wholly UNSET groups preserve the old OPEN behavior but
# emit [ADMISSION] warnings at startup and every interval. Malformed/partial
# groups fail startup. For real funds, SET every group explicitly.
# Pair grammar: strict JSON array, unique lowercase 64hex->64hex strings.
# SOLVER_SUPPORTED_PAIRS=["<64hex-token-in>-><64hex-token-out>"]
# Minimum grammar: strict JSON object; values are positive canonical strings.
# SOLVER_MIN_JOB_OUTPUT={"<64hex-output-token>":"1000000"}
# The DUST group is all SET or all UNSET; amount values are bigint decimals.
# SOLVER_DUST_MAX_PER_JOB=1000000
# SOLVER_DUST_MAX_PER_WINDOW=10000000
# SOLVER_DUST_WINDOW_MS=3600000
SOLVER_ADMISSION_WARNING_INTERVAL_MS=900000

# ── fee sizing ───────────────────────────────────────────────────────────────
# The solver needs NO swap-token inventory to quote or settle whole-maker rungs:
# the DUST fee for the merged settlement is sized from a SYNTHETIC transaction
# with the taker half's shape, because the fee depends on transaction structure
# only. tokenOut inventory buys exactly one thing — INTERIOR (interpolated)
# sizes, whose residual payout comes out of the solver's own Stock. It still
# needs NIGHT/DUST to pay the fee itself.
#
# How many zswap inputs that stand-in models. The relay merges the taker's own
# half and dispatches only numbers, so this count cannot be learned; it is a
# documented over-approximation.
#   * Integer in [1, 64]. Unset = 1. A malformed value is a listed start:solver
#     launch problem, never a silent default; the banner prints the coverage.
#   * MEASURED COVERAGE: modelling n inputs funds a real taker half of up to
#     n + 2 zswap inputs. Default 1 therefore covers takers paying from up to
#     three coins, and reserves exactly what the pre-00006 design reserved.
#   * RAISING IT SPENDS REAL DUST: +12-14% per extra modelled input, and the
#     dust intent SPENDS the estimate rather than merely reserving it — so a
#     higher value also consumes SOLVER_DUST_MAX_PER_JOB / _PER_WINDOW faster.
#   * Under-modelling is an AVAILABILITY failure, not a loss: the chain rejects
#     the merged transaction, the relay reports submit-failed, and the solver's
#     own contribution is reverted. Raise this only if that is what you see.
# SOLVER_FEE_SIZING_TAKER_INPUTS=1
