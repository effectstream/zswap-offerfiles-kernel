{
  "name": "zswap-da",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/contracts-midnight/contract-offer-files",
    "docs"
  ],
  "scripts": {
    "fix:celestia": "bun run scripts/patch-macos-celestia.ts",
    "predev": "bun run scripts/patch-macos-celestia.ts",
    "dev": "NODE_ENV=development bunx orchestrator start",
    "pretest": "bun run scripts/patch-macos-celestia.ts",
    "start:mainnet": "bun run start.mainnet.ts",
    "start:solver": "bun run start.solver.ts",
    "start:solver-frontend": "bun run start.solver-frontend.ts",
    "test": "bun run packages/tests/run-tests.ts",
    "test:grand": "bun run packages/tests/grand-e2e/run.ts",
    "seed:market": "bun run packages/tests/seed-market.ts",
    "build:midnight": "bun run --filter @zswap-da/contract-offer-files compact",
    "build:pgtypes": "bun run --filter @zswap-da/database pgtyped:update",
    "check:compact-artifacts": "bun run scripts/check-compact-artifacts.ts",
    "check:compact-runtime": "bun run scripts/check-compact-runtime.ts",
    "check:pgtypes": "bun run scripts/check-pgtyped.ts",
    "docs:dev": "bun run --filter @zswap-da/docs-playground dev",
    "docs:build": "bun run --filter @zswap-da/docs-playground build",
    "docs:preview": "bun run --filter @zswap-da/docs-playground preview",
    "typecheck:backend": "bun run scripts/backend-typecheck.ts",
    "typecheck:solver": "bun run scripts/solver-typecheck.ts",
    "typecheck:price-feed": "bun run scripts/price-feed-typecheck.ts",
    "typecheck": "bun run typecheck:backend && bun run typecheck:solver && bun run typecheck:price-feed",
    "test:held-open": "bun test ./packages/database/held-open-transaction.pgtest.ts"
  },
  "dependencies": {
    "@effectstream/celestia": "0.200.2",
    "@effectstream/midnight-contracts": "0.200.2",
    "@effectstream/mip-zswap-offer": "0.4.0-v9.0",
    "@effectstream/orchestrator": "0.200.2",
    "@electric-sql/pglite": "^0.3.14",
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-beta.6",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-beta.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-capabilities": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-hd": "3.1.0-beta.1",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0-beta.2",
    "@scure/bip39": "^2.2.0",
    "wait-on": "8.0.3"
  },
  "effectstream": {
    "default": "start.dev.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3"
  }
}
