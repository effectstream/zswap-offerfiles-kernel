# Celestia Mainnet Beta config for `bun run dev:celestia-mainnet`
#
# Prerequisites:
#   celestia light init --p2p.network celestia
#   celestia light start --core.ip <consensus-rpc> --core.port 9090 --core.tls --p2p.network celestia
#   celestia light auth admin --p2p.network celestia   # paste output into CELESTIA_AUTH_TOKEN below
#
# Fund the `celestia1...` address shown by `celestia state account-address`
# with real TIA before submitting blobs.

CELESTIA_NETWORK=mainnet
CELESTIA_RPC_URL=http://127.0.0.1:26658
CELESTIA_AUTH_TOKEN=

# 10 bytes of hex entropy (last 10 bytes of the 28-byte v0 namespace id).
# Leading 18 bytes are zero-padded automatically.
CELESTIA_NAMESPACE=000000000000deadbeef

# Optional: pin a specific start height. Defaults to the current chain head
# when unset and CELESTIA_NETWORK=mainnet.
# CELESTIA_START_HEIGHT=

# Mainnet TxConfig (celestia-node v0.30+). Each field you set here removes one
# consensus-gRPC call per submit — this is the biggest lever for avoiding 429s.
#
# Recommended mainnet settings (minimum on-chain gas price is 0.002 utia/gas;
# leave `gas` unset so blob size is still auto-estimated):
# CELESTIA_GAS_PRICE=0.002         # utia per gas. Skip min-gas-price lookup.
# CELESTIA_MAX_GAS_PRICE=0.01      # safety cap during fee-market spikes
# CELESTIA_TX_PRIORITY=1           # 1=Low 2=Medium(default) 3=High
#
# Advanced (skip gas simulation too — use only if you know your blob size):
# CELESTIA_GAS=80000               # covers ~1-share blob with headroom

# Sync polling cadence (ms). Default on mainnet = 30000 (~2.5 blocks) to stay
# under public consensus gRPC rate limits. Raise to 60000+ if you still hit 429s.
# CELESTIA_POLLING_INTERVAL_MS=

# Absolute node → batcher deadline, including receipt body consumption.
# BATCHER_SUBMIT_TIMEOUT_MS=310000

# Persistent SSE connections are capped separately from the request/minute
# limiter. Slow consumers are disconnected instead of buffering indefinitely.
# API_SSE_MAX_CONNECTIONS=100

# The websocket update stream (GET /v1/offers/updates) is capped separately
# from SSE: an upgrade request never reaches the request/minute limiter, so
# concurrent subscriptions are this endpoint's only resource boundary.
# API_UPDATES_MAX_CONNECTIONS=100

# Decision budget for one exact-files read (POST /v1/offers/files). Default
# 15000 ms, hard-capped at 60000 ms.
# OFFER_FILES_READ_TIMEOUT_MS=15000

# Solver process safety boundary. The mainnet entrypoint defaults to dry-run;
# live settlement requires both of the following explicit values. Keep the
# acknowledgement false until the wallet, ladder config, URLs, and a controlled
# staging rehearsal have been reviewed. Current dry-run mirrors the book but
# does not load wallet inventory, so it is NOT Path-A admission parity.
SOLVER_DRY_RUN=true
SOLVER_MAINNET_LIVE_TRADING_ACK=false

# The unapproved R0 draft proposes posted-price Path A only. Merged-offer Path B, N-cycles, and
# inventory-funded residual top-ups are independent experimental capabilities
# and all stay off by default. Cycles/top-ups have no effect while Path B is off.
SOLVER_ENABLE_PATH_B=false
SOLVER_ENABLE_CYCLES=false
SOLVER_ENABLE_RESIDUAL_TOPUPS=false

# Solver bearer for the pre-match validation gate. That gate targets the
# removed POST /v1/offers/validate and is inert until the solver moves to
# job-time exact-files fetching; startup still requires the value.
SOLVER_LEVELS_AUTH_TOKEN=replace-with-matching-at-least-16-character-secret
