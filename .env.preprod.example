# =============================================================================
# ZSwap-DA kernel — preprod env contract (Midnight 2.x / ledger 9)
#
# One file for the public-network services:
#   [kernel]   packages/node/main.public.ts        (:9999; preflight:
#              bun run packages/node/public-network-profile.ts)
#   [batcher]  packages/batcher/batcher.public.ts  (:3334; preflight: --check)
#   [poster]   deploy/scripts/offer-poster.ts
#   [registry] packages/database/import-token-registry.ts (one-shot)
# Each variable names the services that read it. Uncommented lines are the
# contract; commented lines are optional knobs shown with their default.
# SECRETS are left EMPTY here: fill them only in the real (uncommitted) env,
# never on a command line.
#
# Check a filled-in copy with:  cp .env.preprod.example .env && bun check-env.ts
#
# Preprod constants: block 1 = 2026-03-20T18:23:24Z (NTP anchor
# 1774031004000), ~6 s blocks; Celestia mocha on the MIP-0006 shared
# namespace mn-swap-v1 (6d6e2d737761702d7631, not overridden); zswap root
# window = ledger-9 global_ttl = 1209600 s (14 days).
# =============================================================================

# ── Midnight network [kernel, batcher, poster, registry] ─────────────────────
MIDNIGHT_NETWORK_ID=preprod
# REQUIRED (SECRET): the Blockfrost project token for preprod (one free project
# per network at https://blockfrost.io; a token of another network is refused
# with HTTP 403 "Network token mismatch" and the kernel stops naming this
# variable). The default endpoints are Blockfrost-hosted:
#   https://midnight-preprod.blockfrost.io/api/v0      (indexer, WS …/api/v0/ws)
#   https://rpc.midnight-preprod.blockfrost.io         (node)
# each with ?project_id=<token>. Every logged or served endpoint shows
# project_id=<redacted>.
MIDNIGHT_BLOCKFROST_PROJECT_ID=
# Optional full overrides, each replacing its URL verbatim (all three set =
# no token needed). The Midnight-hosted preprod endpoints
# (indexer.preprod.midnight.network, rpc.preprod.midnight.network) were
# retired on 2026-10-09 and are refused at startup.
# MIDNIGHT_INDEXER_HTTP=
# MIDNIGHT_INDEXER_WS=
# MIDNIGHT_NODE_HTTP=
# A proof server you run (proof-server 9.0.1). The batcher and the poster
# prove; the kernel only advertises it to browser wallets in
# GET /v1/midnight/config.
MIDNIGHT_PROOF_SERVER_URL=http://proof-server:6300
# Older alias of MIDNIGHT_PROOF_SERVER_URL (read when that one is unset).
# MIDNIGHT_PROOF_SERVER=
# [kernel] First Midnight block to index. The nullifier set must be complete,
# so keep 1 (the NTP anchor is block 1's time).
# MIDNIGHT_START_BLOCK=1
# [batcher, poster] wallet-SDK sync budget, ms.
# MIDNIGHT_WALLET_SYNC_TIMEOUT_MS=
# MIDNIGHT_WAIT_DUST_POLL_INTERVAL_MS=

# ── Celestia mocha [kernel, batcher] ─────────────────────────────────────────
# The mocha RPC of a light node / provider whose signer holds mocha TIA (the
# batcher pays one blob fee per sponsored offer). REQUIRED.
CELESTIA_RPC_URL=
# REQUIRED (SECRET): the RPC bearer token (sent as Authorization: Bearer; the
# kernel's sync reads it too). If CELESTIA_RPC_URL embeds its own credential
# (the QuickNode pattern), leave this empty and set CELESTIA_AUTH_IN_URL=true
# instead — never log that URL.
CELESTIA_AUTH_TOKEN=
# CELESTIA_AUTH_IN_URL=false
# [kernel] REQUIRED: the mocha height to start reading offers from. Pin it
# deliberately (at or a little before the first preprod offer you care about);
# there is no fallback to 1. The runtime snapshots it on the first boot and
# refuses a changed value afterwards unless USE_DB_STARTHEIGHT is set.
CELESTIA_START_HEIGHT=
# CELESTIA_NETWORK=mocha
# Leave UNSET: preprod posts and reads the MIP-0006 shared namespace
# 6d6e2d737761702d7631 (mn-swap-v1). Preview kernels share it on mocha; each
# kernel rejects the other network's offers.
# CELESTIA_NAMESPACE=
# [kernel] sync knobs
# CELESTIA_POLLING_INTERVAL_MS=3000
# CELESTIA_STEP_SIZE=200
# CELESTIA_FETCH_CONCURRENCY=12
# [batcher] blob TxConfig (non-mainnet networks use fee + gas limit)
# CELESTIA_FEE=2000
# CELESTIA_GAS_LIMIT=100000
# CELESTIA_GAS_PRICE=
# CELESTIA_GAS=
# CELESTIA_MAX_GAS_PRICE=
# CELESTIA_TX_PRIORITY=

# ── Database: external Postgres [kernel, registry] ───────────────────────────
# PGLITE=false is REQUIRED for an external Postgres: the runtime defaults
# PGLITE to true (single-connection PGlite mode, and DB_PW is then never
# sent). Start on an EMPTY database: data written by a ledger-8 kernel does not
# deserialize under ledger 9.
PGLITE=false
DB_HOST=
DB_PORT=5432
DB_USER=postgres
# SECRET
DB_PW=
DB_NAME=postgres
# [kernel] The Postgres needs the pg_ivm extension
# (https://github.com/sraoss/pg_ivm): the effectstream runtime builds its
# materialized views with it. Without it the node does not start: it exits
# non-zero with "Effectstream startup aborted: the `pg_ivm` PostgreSQL
# extension is not available …", and Postgres logs
# 'extension "pg_ivm" is not available'. ALLOW_NO_PG_IVM=true selects the
# engine's plain-view fallback instead, which effectstream marks as dev/test
# only (reads slow down as the tables grow).
# ALLOW_NO_PG_IVM=false
# [kernel] Only after a deliberate change of CELESTIA_START_HEIGHT /
# NTP_START_TIME on an existing database (the DB snapshot then wins).
# USE_DB_STARTHEIGHT=

# ── Kernel: sync node + API [kernel] ─────────────────────────────────────────
# NTP anchor (preprod block 1) and the 10-minute NTP block time are the
# defaults; override only when resyncing from a different anchor.
# NTP_START_TIME=1774031004000
# BLOCK_TIME_MS=600000
# NTP_STEP_SIZE=1000
# MIDNIGHT_DELAY_MS=30000
# Root window (seconds): default 1209600 = the ledger-9 global_ttl. A shielded
# offer carries no TTL and expires when its proof root leaves this window.
# ROOT_WINDOW_SECONDS=1209600
# OFFER_TTL_SECONDS is not an offer lifetime or cap: offers expire at their own
# ledger limits (root window; intent TTL for intents). It is only the fallback
# for an offer with neither; leave it unset (setting it logs a warning).
# OFFER_TTL_SECONDS=
# EFFECTSTREAM_API_PORT=9999
# Behind a reverse proxy: trust it (true | false | comma-separated IPs/CIDRs).
# EFFECTSTREAM_TRUST_PROXY=true
# Where the kernel forwards POST /v1/offers blobs (the batcher's HTTP API).
BATCHER_SUBMIT_URL=http://batcher:3334
# BATCHER_SUBMIT_TIMEOUT_MS=
# BATCHER_PORT=3334
# POST /v1/known-tokens (register an extra token). Off by default; the route
# has NO authentication — enable only if you accept that anyone can register a
# token name, or insert the rows in Postgres instead.
# ENABLE_TOKEN_REGISTRY=false
# API_RATE_LIMIT_MAX=600
# API_RATE_LIMIT_ALLOWLIST=
# API_SSE_MAX_CONNECTIONS=100
# API_UPDATES_MAX_CONNECTIONS=100
# OFFER_FILES_READ_TIMEOUT_MS=15000
# OFFER_MAX_BYTES=1048576
# ALLOW_CONTRACT_MAKER_OFFERS=false
# PRICE_FEED_MAP=

# ── Fee sponsorship [kernel, batcher] — the SAME names in both ───────────────
# SPONSOR_DISCOUNT_BPS=250
# BATCHER_SPONSOR_POLICY=warn
# BATCHER_SPONSOR_UNPRICED=allow

# ── Batcher [batcher] ────────────────────────────────────────────────────────
# REQUIRED (SECRET): a DEDICATED seed, 64 hex (or 128 from a mnemonic), whose
# NIGHT is registered for DUST. A missing value or any repository dev seed is
# refused (exit 78) — there is no fallback. Never reuse it for another service.
BATCHER_WALLET_SEED=
# REQUIRED: absolute path on a persistent volume — parked inputs and the
# DUST-state cache (${BATCHER_STORAGE_DIR}/dust-state).
BATCHER_STORAGE_DIR=/var/lib/batcher
# The kernel API the batcher asks for prices (GET /v1/prices).
BATCHER_NODE_API_URL=http://kernel:9999
# BATCHER_POLLING_INTERVAL_MS=250
# Concurrent balancing txs: one per registered NIGHT UTXO at most (default 1
# off undeployed). Split the batcher's NIGHT into several UTXOs to raise it.
# BATCHER_MAX_SLOTS_PER_WALLET=1
# BATCHER_MAX_RETRIES=
# BATCHER_RETRY_DELAY_MS=
# BATCHER_DUST_WAIT_TIMEOUT_MS=
# BATCHER_MIN_SPENDABLE_DUST_PER_COIN=
# BATCHER_MAX_INPUT_CHARS=
# BATCHER_PRICE_TTL_MS=600000
# BATCHER_PRICE_MAX_AGE_MS=172800000
# BATCHER_ALLOW_CONTRACT_TX=false

# ── Offer poster [poster] ────────────────────────────────────────────────────
ZSWAP_API=http://kernel:9999
# Older alias of ZSWAP_API (read when that one is unset).
# NODE_URL=
# REQUIRED (SECRET), exactly one: the poster's OWN wallet (a repository dev
# seed is refused). Fund it with the GIVE_TOKEN coins by hand — the poster
# pays no fees.
POSTER_SEED=
# POSTER_MNEMONIC=
# REQUIRED: 64-hex shielded token IDs of preprod tokens.
GIVE_TOKEN=
WANT_TOKEN=
# GIVE_AMOUNT=1
# GIVE_MIN=
# GIVE_MAX=
# WANT_AMOUNT=
# POST_INTERVAL_MS=60000
# Intent TTL only: inert for the poster's shielded-only offers.
# OFFER_TTL_MINUTES=60
# RECONCILE_INTERVAL_MS=60000
# POSTER_MAX_REOFFERS_PER_TICK=1
# SHUTDOWN_GRACE_MS=15000
# HEALTH_STALE_TICKS=3
# POSTER_HEALTH_PORT=9977
# DRY_RUN=false
# POSTER_JOURNAL_FILE=/var/lib/offer-poster/journal.json
# POSTER_JOURNAL_RESET=false
# POSTER_SYNC_TIMEOUT_MS=180000
# POSTER_POST_RETRIES=24
# POSTER_POST_RETRY_MS=5000
# POSTER_LIVE_TRIES=40
# POSTER_LIVE_INTERVAL_MS=5000
# KERNEL_WAIT_TIMEOUT_S=600

# ── Token-registry one-shot [registry] ───────────────────────────────────────
# Imports the network's canonical token registry once per database, after the
# kernel's first start.
TOKEN_REGISTRY_NETWORK=preprod
# TOKEN_REGISTRY_BASE_URL=https://mint-test-tokens.pages.dev/
# TOKEN_REGISTRY_TIMEOUT_MS=5000
# TOKEN_REGISTRY_ATTEMPTS=12
# TOKEN_REGISTRY_RETRY_DELAY_S=10

# ── Reference prices (packages/price-feed) — OPTIONAL ────────────────────────
# The schema seeds USD reference prices, so quotes work with no key. Set the
# key only to have them refreshed daily by the separate `price-feed` process.
# SECRET: never in the repo, never on a command line. Sent as the
# `x-cg-demo-api-key` header, never as a query parameter.
# COINGECKO_API_KEY=
# PRICE_FEED_INTERVAL_MS=86400000
# PRICE_FEED_REQUEST_SPACING_MS=1000
# PRICE_FEED_BATCH_SIZE=50
# PRICE_FEED_ASSETS=bitcoin,ethereum,usd-coin,midnight-3,usdm-2
