# =============================================================================
# ZSwap-DA — Docker Compose preview environment
# cp .env.preview.example .env  then fill in the required values
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED: Midnight contract address deployed to Preview
# Run deploy.ts once with MIDNIGHT_NETWORK_ID=preview + a funded wallet,
# then paste the address printed at the end here.
# ---------------------------------------------------------------------------
MIDNIGHT_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# Midnight network (fixed for this compose file — do not change)
# ---------------------------------------------------------------------------
# MIDNIGHT_WALLET_MNEMONIC="w1 w2 ... w24" 
MIDNIGHT_NETWORK_ID=preview

# ---------------------------------------------------------------------------
# Celestia Mocha-4 — QuickNode hosted DA node (no self-hosted light node).
# Blob reads + writes go through the QuickNode endpoint; auth is embedded
# in the URL so CELESTIA_AUTH_TOKEN is not required.
# ---------------------------------------------------------------------------
CELESTIA_NETWORK=mocha
CELESTIA_NAMESPACE=000000000000deadbeef
CELESTIA_RPC_URL=<your-quicknode-celestia-mocha-url>
CELESTIA_POLLING_INTERVAL_MS=3000

# ---------------------------------------------------------------------------
# Start heights — skip ancient history before Midnight Preview launched.
# Midnight Preview block 1 = 2026-03-25T01:05:42 UTC
# Equivalent Mocha-4 block  = ~10620000 (computed via binary search on RPC)
# ---------------------------------------------------------------------------
MIDNIGHT_START_BLOCK=1
CELESTIA_START_HEIGHT=10620000

# ---------------------------------------------------------------------------
# Midnight batcher wallet (required to submit balancing transactions).
# Convert your 24-word mnemonic to a hex seed:
#   MIDNIGHT_NETWORK_ID=preview bun mnemonic-to-seed.ts
# Paste the printed hex value below.
# ---------------------------------------------------------------------------
BATCHER_WALLET_SEED=<hex-seed-from-mnemonic-to-seed>

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Offer lifetime. Preview root window is ~1h; set ~3600 to keep the active
# set aligned with on-chain fillability.
# OFFER_TTL_SECONDS=3600

# NTP epoch anchoring for the sync node (config.preview.ts). Defaults already
# anchor to Midnight Preview block 1 (2026-03-25T01:05:42 UTC) — override only
# if resyncing from a different start point.
# BLOCK_TIME_MS=600000
# NTP_STEP_SIZE=1000
# NTP_START_TIME=1774400742000
# MIDNIGHT_DELAY_MS=30000

# ---------------------------------------------------------------------------
# Reference prices (packages/price-feed) — OPTIONAL
# ---------------------------------------------------------------------------
# The schema seeds real USD prices for all five assets — bitcoin, ethereum,
# usd-coin, midnight-3 and usdm-2 (captured 2026-09-02) — so quotes are real
# ratios with no key at all. Every price is in USD and nothing is pinned to a
# dollar. Set the key only to have them refreshed daily by the separate
# `price-feed` process (loop mode, or one cycle with `--once`). It is never
# started by a development stack — `start.dev.ts` does not register it — so
# running it is always a deliberate act.
#
# SECRET: keep it here, never in the repo. It is sent as the
# `x-cg-demo-api-key` header, never as a query parameter.
# COINGECKO_API_KEY=<coingecko-demo-key>
# PRICE_FEED_INTERVAL_MS=86400000
# PRICE_FEED_REQUEST_SPACING_MS=1000
# PRICE_FEED_BATCH_SIZE=50
# PRICE_FEED_ASSETS=bitcoin,ethereum,usd-coin,midnight-3,usdm-2

# Sponsorship threshold, in basis points, read by the node (and by the batcher
# as a fallback for the value the node publishes). 250 = 2.5% below reference.
# SPONSOR_DISCOUNT_BPS=250

# Token -> reference asset overrides, merged over the built-in NAME map
# (WBTC/WSBTC/BTC->bitcoin, WETH/WSETH/ETH->ethereum, USDC->usd-coin,
# USDM->usdm-2, NIGHT->midnight-3, SNIGHT->midnight-3).
# `NAME_OR_COLOR=<asset_id>[:decimals]`, comma-separated. A malformed entry is
# a startup error, not a silent skip.
# `decimals` is base units per PRICED coin, never a colour's own display
# decimals — NIGHT needs no override here, it is seeded with decimals=6
# (1 NIGHT = 10^6 Stars) in packages/database/migrations/000-init.sql.
# Neither does a faucet colour: since 00024 EVERY token this stack mints or
# registers has 6 decimals, which is both the column default and what every
# registration path sends.
#
# SNIGHT (the shielded-night wrapper) needs nothing here either: the schema
# seeds it in known_tokens with the PREVIEW colour 793c29c9…f99c, NIGHT's 6
# decimals and midnight-3. Another network patches that seeded row (preprod is
# 8fac382b…6819) — see the SNIGHT note in the same file.
# PRICE_FEED_MAP=WBTC=bitcoin,TESTTOKENA=usd-coin:6

# ── Fee sponsorship (node AND batcher read these SAME names) ────────────────
# Which offers earn a Celestia fee. The batcher's validateInput is
# authoritative (it holds the wallet); POST /v1/offers mirrors it and answers
# 422 NOT_SPONSORED early. Set both services to the same values.
#
# Defaults change nothing about what gets published: `warn` only logs what
# `enforce` would have refused, `allow` keeps unpriced test tokens flowing.
# Roll out with the defaults, read a day of
#   would refuse (policy=warn) - NOT_SPONSORED: ...
# lines, then switch to enforce. An invalid value throws at STARTUP.
# BATCHER_SPONSOR_POLICY=warn          # enforce | warn | off
# BATCHER_SPONSOR_UNPRICED=allow       # allow | reject
#
# The batcher has no database and asks the node for the colours of each offer
# it validates (GET /v1/prices?tokens=). Point it at the
# node's API; inside the compose stack that is http://kernel:9999.
# BATCHER_NODE_API_URL=http://127.0.0.1:9999
# BATCHER_PRICE_TTL_MS=600000          # per-colour cache TTL
# BATCHER_PRICE_MAX_AGE_MS=172800000   # 48 h; how stale an answer may be when a
                                       # re-ask fails. Must be >= the TTL

