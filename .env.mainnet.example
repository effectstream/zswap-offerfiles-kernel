# Celestia Mainnet Beta config for `bun run dev:celestia-mainnet`
#
# Prerequisites:
#   celestia light init --p2p.network celestia
#   celestia light start --core.ip <consensus-rpc> --core.port 9090 --core.tls --p2p.network celestia
#   celestia light auth admin --p2p.network celestia   # paste output into CELESTIA_AUTH_TOKEN below
#
# Fund the `celestia1...` address shown by `celestia state account-address`
# with real TIA before submitting blobs.

CELESTIA_NETWORK=mainnet
CELESTIA_RPC_URL=http://127.0.0.1:26658
CELESTIA_AUTH_TOKEN=

# 10 bytes of hex entropy (last 10 bytes of the 28-byte v0 namespace id).
# Leading 18 bytes are zero-padded automatically.
CELESTIA_NAMESPACE=000000000000deadbeef

# Optional: pin a specific start height. Defaults to the current chain head
# when unset and CELESTIA_NETWORK=mainnet.
# CELESTIA_START_HEIGHT=

# Mainnet TxConfig (celestia-node v0.30+). Each field you set here removes one
# consensus-gRPC call per submit — this is the biggest lever for avoiding 429s.
#
# Recommended mainnet settings (minimum on-chain gas price is 0.002 utia/gas;
# leave `gas` unset so blob size is still auto-estimated):
# CELESTIA_GAS_PRICE=0.002         # utia per gas. Skip min-gas-price lookup.
# CELESTIA_MAX_GAS_PRICE=0.01      # safety cap during fee-market spikes
# CELESTIA_TX_PRIORITY=1           # 1=Low 2=Medium(default) 3=High
#
# Advanced (skip gas simulation too — use only if you know your blob size):
# CELESTIA_GAS=80000               # covers ~1-share blob with headroom

# Sync polling cadence (ms). Default on mainnet = 30000 (~2.5 blocks) to stay
# under public consensus gRPC rate limits. Raise to 60000+ if you still hit 429s.
# CELESTIA_POLLING_INTERVAL_MS=

# Absolute node → batcher deadline, including receipt body consumption.
# BATCHER_SUBMIT_TIMEOUT_MS=310000

# Persistent SSE connections are capped separately from the request/minute
# limiter. Slow consumers are disconnected instead of buffering indefinitely.
# API_SSE_MAX_CONNECTIONS=100

# The websocket update stream (GET /v1/offers/updates) is capped separately
# from SSE: an upgrade request never reaches the request/minute limiter, so
# concurrent subscriptions are this endpoint's only resource boundary.
# API_UPDATES_MAX_CONNECTIONS=100

# Decision budget for one exact-files read (POST /v1/offers/files). Default
# 15000 ms, hard-capped at 60000 ms.
# OFFER_FILES_READ_TIMEOUT_MS=15000

# ── COW solver component (bun run start:solver) ───────────────────────────────
# `start:solver` runs the solver as its OWN process; `bun run start:mainnet`
# deliberately does not launch it. That entrypoint requires all of
# MIDNIGHT_NETWORK_ID, ZSWAP_API, SOLVER_SEED, SOLVER_RELAY_WS_URL,
# SOLVER_RELAY_HTTP_URL, SOLVER_RELAY_AUTH_TOKEN and SOLVER_JOURNAL_PATH — in
# dry-run as well as live mode — and exits non-zero listing every missing or
# malformed one before it opens a wallet, socket or journal.
# Kernel Offer Files API the solver mirrors. Unset means http://127.0.0.1:9999,
# which start:solver refuses to assume for a deployment.
ZSWAP_API=http://127.0.0.1:9999

# Solver process safety boundary. The mainnet entrypoint defaults to dry-run;
# live settlement requires both of the following explicit values. Keep the
# acknowledgement false until the wallet, ladder config, URLs, and a controlled
# staging rehearsal have been reviewed. Dry-run requires SOLVER_SEED, syncs the
# real wallet, and loads read-only inventory, but starts no relay jobs and calls
# no mutating wallet methods.
SOLVER_DRY_RUN=true
SOLVER_MAINNET_LIVE_TRADING_ACK=false

# BREAKING for RF3 dry-run too: the mainnet entrypoint refuses the repository's
# public dev seed in every mode. Supply the funded mainnet wallet seed through
# your secret manager; never commit it here. `start:solver` accepts that dev
# seed only on MIDNIGHT_NETWORK_ID=undeployed.
# FUND BOTH SIDES: the solver publishes only the ladder prefix its own holdings
# can execute, so a wallet without the INPUT token of a pair publishes nothing
# for that pair, and one without the OUTPUT token cannot pay interior residuals.
SOLVER_SEED=

# BREAKING / REQUIRED before relay job execution: mount a persistent volume
# per solver instance and point this at an absolute path inside that mount.
# Docker example: --mount type=volume,src=cow-solver-journal,dst=/var/lib/cow-solver
# Never share one SQLite file between solver instances. Production rejects
# :memory: even when SOLVER_JOURNAL_ALLOW_MEMORY is set (that flag is harness-only).
SOLVER_JOURNAL_PATH=/var/lib/cow-solver/operations.sqlite

# Outbound Midnight Intents solver socket plus the independent public HTTP base
# for durable GET /jobs/:jobId recovery. Do not derive/rewrite one from the
# other: deployed prefixes may differ. The backend exact-files/consumption
# reads have no bearer; this credential is scoped only to the relay upgrade.
SOLVER_RELAY_WS_URL=wss://replace-with-relay.example/solver
SOLVER_RELAY_HTTP_URL=https://replace-with-relay.example/api/v1
SOLVER_RELAY_AUTH_TOKEN=replace-with-matching-at-least-32-character-relay-secret
SOLVER_RELAY_MAX_PARALLEL_SWAPS=8
SOLVER_RELAY_PUSH_INTERVAL_MS=1000
SOLVER_RELAY_RECONNECT_DELAY_MS=2000
SOLVER_STATUS_POLL_MS=5000
SOLVER_SETTLE_TTL_MINUTES=30

# Economic admission. Wholly UNSET groups preserve the old OPEN behavior but
# emit [ADMISSION] warnings at startup and every interval. Malformed/partial
# groups fail startup. For real funds, SET every group explicitly.
# Pair grammar: strict JSON array, unique lowercase 64hex->64hex strings.
# SOLVER_SUPPORTED_PAIRS=["<64hex-token-in>-><64hex-token-out>"]
# Minimum grammar: strict JSON object; values are positive canonical strings.
# SOLVER_MIN_JOB_OUTPUT={"<64hex-output-token>":"1000000"}
# The DUST group is all SET or all UNSET; amount values are bigint decimals.
# SOLVER_DUST_MAX_PER_JOB=1000000
# SOLVER_DUST_MAX_PER_WINDOW=10000000
# SOLVER_DUST_WINDOW_MS=3600000
SOLVER_ADMISSION_WARNING_INTERVAL_MS=900000

# ── fee sizing ───────────────────────────────────────────────────────────────
# The solver needs NO swap-token inventory to quote or settle whole-maker rungs:
# the DUST fee for the merged settlement is sized from a SYNTHETIC transaction
# with the taker half's shape, because the fee depends on transaction structure
# only. tokenOut inventory buys exactly one thing — INTERIOR (interpolated)
# sizes, whose residual payout comes out of the solver's own Stock. It still
# needs NIGHT/DUST to pay the fee itself.
#
# How many zswap inputs that stand-in models. The relay merges the taker's own
# half and dispatches only numbers, so this count cannot be learned; it is a
# documented over-approximation.
#   * Integer in [1, 64]. Unset = 1. A malformed value is a listed start:solver
#     launch problem, never a silent default; the banner prints the coverage.
#   * MEASURED COVERAGE: modelling n inputs funds a real taker half of up to
#     n + 2 zswap inputs. Default 1 therefore covers takers paying from up to
#     three coins, and reserves exactly what the pre-00006 design reserved.
#   * RAISING IT SPENDS REAL DUST: +12-14% per extra modelled input, and the
#     dust intent SPENDS the estimate rather than merely reserving it — so a
#     higher value also consumes SOLVER_DUST_MAX_PER_JOB / _PER_WINDOW faster.
#   * Under-modelling is an AVAILABILITY failure, not a loss: the chain rejects
#     the merged transaction, the relay reports submit-failed, and the solver's
#     own contribution is reverted. Raise this only if that is what you see.
# SOLVER_FEE_SIZING_TAKER_INPUTS=1

# ---------------------------------------------------------------------------
# Reference prices (packages/price-feed) — OPTIONAL
# ---------------------------------------------------------------------------
# A separate process (`bun run --filter @zswap-da/price-feed start`) refreshes
# `asset_prices` from CoinGecko once a day. It is optional: the schema ships
# seeded prices, and without a key loop mode idles rather than failing.
#
# MAINNET NOTE: the seeded values were captured on 2026-09-02 and are a
# DEVELOPMENT baseline. On a deployment where the sponsorship gate decides
# whether real fees are paid, run the feed — a stale reference price is what
# makes "2.5% below market" mean the wrong thing.
#
# SECRET: never in the repo, never on a command line. Sent as the
# `x-cg-demo-api-key` header, never as a query parameter.
# COINGECKO_API_KEY=<coingecko-key>
# PRICE_FEED_INTERVAL_MS=86400000
# PRICE_FEED_REQUEST_SPACING_MS=1000
# PRICE_FEED_BATCH_SIZE=50
# PRICE_FEED_ASSETS=bitcoin,ethereum,usd-coin,midnight-3,usdm-2

# Sponsorship threshold in basis points. 250 = 2.5% below reference.
# SPONSOR_DISCOUNT_BPS=250

# Token -> reference asset overrides merged over the built-in NAME map:
# `NAME_OR_COLOR=<asset_id>[:decimals]`, comma-separated. `decimals` here is
# always base units per PRICED coin (never a colour's own display decimals).
# NIGHT itself needs no override: it is seeded with decimals=6 (1 NIGHT =
# 10^6 Stars) in packages/database/migrations/000-init.sql. On mainnet the
# USDM token type is 8c2c22bc0c37fa999d0611cb5c570f587938ac5ffc8b0925143dad4c0764e94b
# (the seed carries the *preview* type), so map it by colour here:
# PRICE_FEED_MAP=8c2c22bc0c37fa999d0611cb5c570f587938ac5ffc8b0925143dad4c0764e94b=usdm-2:6

# ── Fee sponsorship (node AND batcher read these SAME names) ────────────────
# Which offers earn a Celestia fee. The batcher's validateInput is
# authoritative (it holds the wallet); POST /v1/offers mirrors it and answers
# 422 NOT_SPONSORED early. Set both services to the same values.
#
# Defaults change nothing about what gets published: `warn` only logs what
# `enforce` would have refused, `allow` keeps unpriced test tokens flowing.
# Roll out with the defaults, read a day of
#   would refuse (policy=warn) - NOT_SPONSORED: ...
# lines, then switch to enforce. An invalid value throws at STARTUP.
# BATCHER_SPONSOR_POLICY=warn          # enforce | warn | off
# BATCHER_SPONSOR_UNPRICED=allow       # allow | reject
#
# The batcher has no database and asks the node for the colours of each offer
# it validates (GET /v1/prices?tokens=). Point it at the
# node's API; inside the compose stack that is http://kernel:9999.
# BATCHER_NODE_API_URL=http://127.0.0.1:9999
# BATCHER_PRICE_TTL_MS=600000          # per-colour cache TTL
# BATCHER_PRICE_MAX_AGE_MS=172800000   # 48 h; how stale an answer may be when a
                                       # re-ask fails. Must be >= the TTL

