# =============================================================================
# ZSwap-DA (kernel ledger-v9 line) — stagenet env contract
#
# One file for the four stagenet services of the kernel image:
#   [kernel]   entrypoint-kernel.sh  -> packages/node/main.stagenet.ts   (:9999)
#   [batcher]  entrypoint-batcher.sh -> packages/batcher/batcher.stagenet.ts (:3334)
#   [poster]   entrypoint-offer-poster.sh -> deploy/scripts/offer-poster.ts
#   [registry] entrypoint-token-registry.sh (one-shot, after the kernel's first start)
# Each variable names the services that read it. Uncommented lines are the
# contract; commented lines are optional knobs shown with their default.
# SECRETS are left EMPTY here: fill them only in the real (uncommitted) env.
#
# Check a filled-in copy with:  cp .env.stagenet.example .env && bun check-env.ts
# Full runbook: README.md, "Running against stagenet".
#
# Stagenet constants (00050): node 2.0.0-d9729c13, block 1 = 2026-08-13T16:24:54Z
# (NTP anchor 1786638294000), ~6 s blocks; Celestia mocha on the MIP-0006
# shared namespace mn-swap-v1 (6d6e2d737761702d7631, not overridden); zswap
# root window = ledger-9 global_ttl = 1209600 s (14 days).
# =============================================================================

# ── Midnight network [kernel, batcher, poster, registry] ─────────────────────
MIDNIGHT_NETWORK_ID=stagenet
# Endpoints. The image entrypoints require them explicitly (kernel, batcher);
# the poster defaults to the same Shielded Tools hosts. The node URL must be
# HTTP(S): the entrypoints' readiness probe speaks JSON-RPC over HTTP, and the
# wallet SDK turns https:// into wss:// itself.
MIDNIGHT_NODE_HTTP=https://rpc.stagenet.shielded.tools
MIDNIGHT_INDEXER_HTTP=https://indexer.stagenet.shielded.tools/api/v4/graphql
MIDNIGHT_INDEXER_WS=wss://indexer.stagenet.shielded.tools/api/v4/graphql/ws
# A proof server you run (dust/9 keys: midnightntwrk/proof-server 9.0.0-rc.5 or
# rc.6). The batcher and the poster prove; the kernel only advertises it to
# browser wallets in GET /v1/midnight/config.
MIDNIGHT_PROOF_SERVER_URL=http://proof-server:6300
# Older alias of MIDNIGHT_PROOF_SERVER_URL (read when that one is unset).
# MIDNIGHT_PROOF_SERVER=
# [kernel] First Midnight block to index. Stagenet block 1 matches the NTP anchor.
# MIDNIGHT_START_BLOCK=1
# [batcher, poster] wallet-SDK sync budget, ms.
# MIDNIGHT_WALLET_SYNC_TIMEOUT_MS=
# MIDNIGHT_WAIT_DUST_POLL_INTERVAL_MS=

# ── Celestia mocha [kernel, batcher] ─────────────────────────────────────────
# The mocha RPC of a light node / provider whose signer holds mocha TIA (the
# batcher pays one blob fee per sponsored offer). REQUIRED on stagenet.
CELESTIA_RPC_URL=
# REQUIRED (SECRET): the RPC bearer token (sent as Authorization: Bearer; the
# kernel's sync reads it too). If CELESTIA_RPC_URL embeds its own credential
# (the QuickNode pattern preview uses), leave this empty and set
# CELESTIA_AUTH_IN_URL=true instead — never log that URL.
CELESTIA_AUTH_TOKEN=
# CELESTIA_AUTH_IN_URL=false
# [kernel] REQUIRED: the mocha height to start reading offers from. Pin it
# deliberately (at or a little before the first stagenet offer you care
# about); there is no fallback to 1. The runtime snapshots it on the first
# boot and refuses a changed value afterwards unless USE_DB_STARTHEIGHT is set.
CELESTIA_START_HEIGHT=
# CELESTIA_NETWORK=mocha
# Leave UNSET: stagenet posts and reads the MIP-0006 shared namespace
# 6d6e2d737761702d7631 (mn-swap-v1). Kernels on it read only their own
# network's offers (other networks' blobs fail the root-liveness/proof checks).
# CELESTIA_NAMESPACE=
# [kernel] sync knobs
# CELESTIA_POLLING_INTERVAL_MS=3000
# CELESTIA_STEP_SIZE=200
# CELESTIA_FETCH_CONCURRENCY=12
# [batcher] blob TxConfig (non-mainnet networks use fee + gas limit)
# CELESTIA_FEE=2000
# CELESTIA_GAS_LIMIT=100000
# CELESTIA_GAS_PRICE=
# CELESTIA_GAS=
# CELESTIA_MAX_GAS_PRICE=
# CELESTIA_TX_PRIORITY=

# ── Database: external Postgres [kernel, registry] ───────────────────────────
# You run the Postgres (00050 Q4). PGLITE=false is REQUIRED for it: the
# runtime defaults PGLITE to true (single-connection PGlite mode, and DB_PW is
# then never sent).
PGLITE=false
DB_HOST=
DB_PORT=5432
DB_USER=postgres
# SECRET
DB_PW=
DB_NAME=postgres
# [kernel] Only after a deliberate change of CELESTIA_START_HEIGHT /
# NTP_START_TIME on an existing database (the DB snapshot then wins).
# USE_DB_STARTHEIGHT=

# ── Kernel: sync node + API [kernel] ─────────────────────────────────────────
# NTP anchor (stagenet block 1) and preview's 10-minute NTP block time are the
# stagenet defaults; override only when resyncing from a different anchor.
# NTP_START_TIME=1786638294000
# BLOCK_TIME_MS=600000
# NTP_STEP_SIZE=1000
# MIDNIGHT_DELAY_MS=30000
# Root window (seconds) and offer TTL: default 1209600 = stagenet's global_ttl.
# ROOT_WINDOW_SECONDS=1209600
# OFFER_TTL_SECONDS=1209600
# EFFECTSTREAM_API_PORT=9999
# Behind a reverse proxy: trust it (true | false | comma-separated IPs/CIDRs).
# EFFECTSTREAM_TRUST_PROXY=true
# Where the kernel forwards POST /v1/offers blobs (the batcher's HTTP API).
BATCHER_SUBMIT_URL=http://batcher:3334
# BATCHER_SUBMIT_TIMEOUT_MS=
# BATCHER_PORT=3334
# POST /v1/known-tokens (register an extra token, e.g. 00053's stk tokens).
# Off by default; the route has NO authentication — enable only if you accept
# that anyone can register a token name, or insert the rows in Postgres instead.
# ENABLE_TOKEN_REGISTRY=false
# API_RATE_LIMIT_MAX=600
# API_RATE_LIMIT_ALLOWLIST=
# API_SSE_MAX_CONNECTIONS=100
# API_UPDATES_MAX_CONNECTIONS=100
# OFFER_FILES_READ_TIMEOUT_MS=15000
# OFFER_MAX_BYTES=1048576
# ALLOW_CONTRACT_MAKER_OFFERS=false
# PRICE_FEED_MAP=
# Readiness waits in the kernel entrypoint, seconds.
# DB_WAIT_TIMEOUT_S=300
# NODE_BLOCK_TIMEOUT_S=600
# INDEXER_WAIT_TIMEOUT_S=300
# PROOF_WAIT_TIMEOUT_S=300
# CELESTIA_WAIT_TIMEOUT_S=600

# ── Fee sponsorship [kernel, batcher] — the SAME names in both ───────────────
# SPONSOR_DISCOUNT_BPS=250
# BATCHER_SPONSOR_POLICY=warn
# BATCHER_SPONSOR_UNPRICED=allow

# ── Batcher [batcher] ────────────────────────────────────────────────────────
# REQUIRED (SECRET): a DEDICATED seed, 64 hex (or 128 from a mnemonic), whose
# NIGHT is registered for DUST. A missing value or any repository dev seed is
# refused (exit 78) — there is no fallback. Never reuse it for another service.
BATCHER_WALLET_SEED=
# REQUIRED: absolute path on a persistent volume — parked inputs and the
# DUST-state cache (${BATCHER_STORAGE_DIR}/dust-state).
BATCHER_STORAGE_DIR=/var/lib/batcher
# The kernel API the batcher asks for prices (GET /v1/prices).
BATCHER_NODE_API_URL=http://kernel:9999
# BATCHER_PORT=3334
# BATCHER_POLLING_INTERVAL_MS=250
# Concurrent balancing txs: one per registered NIGHT UTXO at most (default 1
# off undeployed). Split the batcher's NIGHT into several UTXOs to raise it.
# BATCHER_MAX_SLOTS_PER_WALLET=1
# BATCHER_MAX_RETRIES=
# BATCHER_RETRY_DELAY_MS=
# BATCHER_DUST_WAIT_TIMEOUT_MS=
# BATCHER_MIN_SPENDABLE_DUST_PER_COIN=
# BATCHER_MAX_INPUT_CHARS=
# BATCHER_PRICE_TTL_MS=600000
# BATCHER_PRICE_MAX_AGE_MS=172800000
# BATCHER_ALLOW_CONTRACT_TX=false

# ── Offer poster [poster] ────────────────────────────────────────────────────
ZSWAP_API=http://kernel:9999
# Older alias of ZSWAP_API (read when that one is unset).
# NODE_URL=
# REQUIRED (SECRET), exactly one: the poster's OWN wallet (a repository dev
# seed is refused on stagenet). Fund it with the GIVE_TOKEN coins by hand
# (stagenet faucet) — the poster pays no fees.
POSTER_SEED=
# POSTER_MNEMONIC=
# REQUIRED: 64-hex token IDs from the stagenet registry
# (https://mint-test-tokens.pages.dev/metadata.stagenet.json), shielded only.
GIVE_TOKEN=
WANT_TOKEN=
# GIVE_AMOUNT=1
# GIVE_MIN=
# GIVE_MAX=
# WANT_AMOUNT=
# POST_INTERVAL_MS=60000
# OFFER_TTL_MINUTES=60
# RECONCILE_INTERVAL_MS=60000
# POSTER_MAX_REOFFERS_PER_TICK=1
# SHUTDOWN_GRACE_MS=15000
# HEALTH_STALE_TICKS=3
# POSTER_HEALTH_PORT=9977
# DRY_RUN=false
# POSTER_JOURNAL_FILE=/var/lib/offer-poster/journal.json
# POSTER_JOURNAL_RESET=false
# POSTER_SYNC_TIMEOUT_MS=180000
# POSTER_POST_RETRIES=24
# POSTER_POST_RETRY_MS=5000
# POSTER_LIVE_TRIES=40
# POSTER_LIVE_INTERVAL_MS=5000
# KERNEL_WAIT_TIMEOUT_S=600

# ── Token-registry one-shot [registry] ───────────────────────────────────────
# Replaces the seeded Preprod token rows with the stagenet registry (and drops
# the Preprod SNIGHT). Run once per database, after the kernel's first start.
TOKEN_REGISTRY_NETWORK=stagenet
# TOKEN_REGISTRY_BASE_URL=https://mint-test-tokens.pages.dev/
# TOKEN_REGISTRY_TIMEOUT_MS=5000
# TOKEN_REGISTRY_ATTEMPTS=12
# TOKEN_REGISTRY_RETRY_DELAY_S=10
